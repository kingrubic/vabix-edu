# Required in production
AUTH_SECRET=generate-a-long-random-string
NODE_ENV=production

# Optional — when unset, the app uses the local encrypted-at-rest-equivalent JSON store in /data
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mybizcar

# Host that should serve the MyBizCar app at /
BIZCAR_HOST=bizcar.vabix.edu.vn

# Existing corporate site
LEAD_WEBHOOK_URL=
