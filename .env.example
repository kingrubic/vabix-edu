# Required in production
AUTH_SECRET=generate-a-long-random-string
NODE_ENV=production

# Published MyBizCar demo password (shared across @demo.vabix.edu.vn accounts).
# Required the first time Convex is empty, or when BIZCAR_FORCE_RESEED=1.
# Leave empty here; set the real value in .env.local. Never commit a live password.
BIZCAR_DEMO_SEED_PASSWORD=
# Set to 1 once to replace Convex MyBizCar tables with the demo seed, then unset.
BIZCAR_FORCE_RESEED=

# Convex local backend — `npm run dev` / `npx convex dev` writes real values to .env.local
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Host that should serve the MyBizCar app at /
BIZCAR_HOST=bizcar.vabix.edu.vn

# Existing corporate site
LEAD_WEBHOOK_URL=
