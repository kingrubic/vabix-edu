# Required in production
AUTH_SECRET=generate-a-long-random-string
NODE_ENV=production

# Optional override for the public MyBizCar demo password (see src/db/demoAccounts.ts).
# Used on first JSON seed and filled into /bizcar/login when a demo account is clicked.
# Existing stores keep their hash. Leave empty to use the well-known public demo constant.
BIZCAR_DEMO_SEED_PASSWORD=

# Optional — when unset, the app uses the local encrypted-at-rest-equivalent JSON store in /data
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mybizcar

# Host that should serve the MyBizCar app at /
BIZCAR_HOST=bizcar.vabix.edu.vn

# Existing corporate site
LEAD_WEBHOOK_URL=

# VABIX platform (CMS / LMS / IAM)
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_PASSWORD=
PLATFORM_PUBLIC_URL=http://localhost:3000
PLATFORM_JOB_SECRET=
EMAIL_WEBHOOK_URL=
SMTP_URL=

# Platform auth/IAM on Convex (NOT MyBizCar). Do not reuse the MyBizCar `users` table.
# Production deployment: prod:accomplished-rabbit-409
CONVEX_URL=https://accomplished-rabbit-409.convex.cloud
# Same value as `npx convex env set PLATFORM_CONVEX_SECRET`. Never commit the real secret.
PLATFORM_CONVEX_SECRET=
# Deploy/migrate CLI only. Never commit.
# CONVEX_DEPLOY_KEY=
